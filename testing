-- KOT Hub — generated by GuiForge
-- Reference resolution: 1280×720
-- Adaptivity: pure Scale (the UI stretches to the screen size,
-- UIAspectRatioConstraint keeps the proportions of the key elements)
-- Setup: a LocalScript in StarterPlayer > StarterPlayerScripts

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

-- === UI runtime library (shared; a separate ModuleScript in the modular export) ===
local UI = (function()
	local TweenService = game:GetService("TweenService")
	local RunService = game:GetService("RunService")
	local UserInputService = game:GetService("UserInputService")

	local UI = {}
	UI.Data = {}
	UI.NodeStates = {}
	UI.Windows = {}
	UI.Tabs = {}
	UI.Toggles = {}
	UI.Theme = {} -- project theme tokens (filled in during the build)
	UI.Bars = {}
	UI.Sliders = {}
	UI.Cooldowns = {}
	UI.Rolls = {}
	UI.Emitters = {}
	UI.SkillTrees = {}
	UI.SkillTreeNameConflicts = {}
	UI.Events = {}
	UI.BarInfo = TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	UI.BarFast = TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	UI.CountUpInfo = TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

	-- === Sounds: UI.RegisterSounds({ Click = "123456" }) + UI.PlaySound("Click") ===
	local soundIds = {}
	local soundCache = {}
	function UI.RegisterSounds(t)
		for k, v in pairs(t) do
			soundIds[k] = v
		end
	end
	function UI.PlaySound(name)
		local id = name and soundIds[name]
		if not id or id == "" then return end
		local s = soundCache[name]
		if not s then
			s = Instance.new("Sound")
			s.SoundId = "rbxassetid://" .. id
			s.Parent = UI.Gui or workspace
			soundCache[name] = s
		end
		s:Play()
	end
	-- Named events: Roll and outside game code can publish the same signal
	function UI.OnEvent(name, fn)
		local listeners = UI.Events[name]
		if not listeners then listeners = {}; UI.Events[name] = listeners end
		table.insert(listeners, fn)
		return function()
			local i = table.find(listeners, fn)
			if i then table.remove(listeners, i) end
		end
	end
	function UI.EmitEvent(name, ...)
		local listeners = UI.Events[name]
		if listeners then for _, fn in ipairs(table.clone(listeners)) do task.spawn(fn, ...) end end
	end

	-- === Tooltip prefab runtime: hover/focus, typed bindings and viewport-safe placement ===
	UI.TooltipScale = UI.TooltipScale or 1
	UI.TooltipTemplates = {}
	UI.TooltipTargets = {}
	UI.TooltipNameConflicts = {}
	UI.TooltipAssignments = setmetatable({}, { __mode = "k" })
	local tooltipOverlay = nil
	local tooltipActive = nil
	local tooltipPositionConnection = nil
	local tooltipSerial = 0
	local function tooltipEnsureOverlay()
		if tooltipOverlay and tooltipOverlay.Parent then return tooltipOverlay end
		if not UI.Gui then return nil end
		tooltipOverlay = Instance.new("Frame")
		tooltipOverlay.Name = "TooltipLayer"
		tooltipOverlay.BackgroundTransparency = 1
		tooltipOverlay.BorderSizePixel = 0
		tooltipOverlay.Size = UDim2.fromScale(1, 1)
		tooltipOverlay.Active = false
		tooltipOverlay.ZIndex = 10000
		tooltipOverlay.Parent = UI.Gui
		return tooltipOverlay
	end
	local function tooltipCoerce(parameter, raw)
		if raw == nil then raw = parameter.defaultValue end
		if parameter.type == "number" then return tonumber(raw) or tonumber(parameter.defaultValue) or 0 end
		if parameter.type == "boolean" then
			if type(raw) == "boolean" then return raw end
			if raw == "false" or raw == "0" or raw == 0 or raw == "" then return false end
			return raw ~= nil and true or parameter.defaultValue == true
		end
		return raw == nil and "" or tostring(raw)
	end
	local function tooltipResolveValues(template, values)
		local resolved = {}
		for _, parameter in ipairs(template.parameters or {}) do
			local raw = values and values[parameter.id]
			if raw == nil and values then raw = values[parameter.key] end
			resolved[parameter.id] = tooltipCoerce(parameter, raw)
		end
		return resolved
	end
	local function tooltipMergeValues(config, template, supplied)
		if type(supplied) ~= "table" then return end
		config.values = config.values or {}
		for key, value in pairs(supplied) do
			local canonical = key
			for _, parameter in ipairs(template.parameters or {}) do
				if key == parameter.id or key == parameter.key then canonical = parameter.id; config.values[parameter.key] = nil; break end
			end
			config.values[canonical] = value
		end
	end
	local function tooltipFormatPart(part, parametersById, values)
		if part.kind == "literal" then return tostring(part.value or "") end
		local parameter = parametersById[part.paramId]
		if not parameter then return "" end
		local value = values[parameter.id]
		local text
		if parameter.type == "number" then
			local numberValue = tonumber(value) or 0
			if part.decimals ~= nil then
				local decimals = math.clamp(math.floor(tonumber(part.decimals) or 0), 0, 8)
				text = string.format("%." .. tostring(decimals) .. "f", numberValue)
			else
				local rounded = math.round(numberValue * 1000) / 1000
				text = tostring(rounded)
			end
		elseif parameter.type == "boolean" then
			text = value and (part.trueText or "Да") or (part.falseText or "Нет")
		else text = tostring(value or "") end
		local label = part.includeLabel and (tostring(parameter.label or parameter.key) .. tostring(part.separator or ": ")) or ""
		return tostring(part.prefix or "") .. label .. text .. tostring(part.suffix or "")
	end
	local function tooltipApplyBindings(clone, template, rawValues)
		local values = tooltipResolveValues(template, rawValues)
		local parametersById, nodesById = {}, {}
		for _, parameter in ipairs(template.parameters or {}) do parametersById[parameter.id] = parameter end
		local all = { clone }
		for _, descendant in ipairs(clone:GetDescendants()) do table.insert(all, descendant) end
		for _, descendant in ipairs(all) do
			local sourceId = descendant:GetAttribute("TooltipSourceId")
			if sourceId then nodesById[sourceId] = descendant end
		end
		for _, binding in ipairs(template.bindings or {}) do
			local source = nodesById[binding.nodeId]
			if source and binding.target == "runtime-visible" and source:IsA("GuiObject") then
				local visible = values[binding.paramId] == true
				source.Visible = binding.invert and not visible or (not binding.invert and visible)
			elseif source and binding.target == "text" then
				local chunks = {}
				for _, part in ipairs(binding.parts or {}) do table.insert(chunks, tooltipFormatPart(part, parametersById, values)) end
				local text = table.concat(chunks)
				local textTarget = source:GetAttribute("TooltipTextTarget") and source or nil
				if not textTarget then
					for _, descendant in ipairs(source:GetDescendants()) do
						if descendant:GetAttribute("TooltipTextTarget") then textTarget = descendant; break end
					end
				end
				if textTarget and (textTarget:IsA("TextLabel") or textTarget:IsA("TextButton") or textTarget:IsA("TextBox")) then textTarget.Text = text end
				local shadow = source:FindFirstChild("TextShadow")
				if shadow and shadow:IsA("TextLabel") then shadow.Text = text end
			end
		end
		return values
	end
	local function tooltipSanitize(clone, pointerBridge)
		local all = { clone }
		for _, descendant in ipairs(clone:GetDescendants()) do table.insert(all, descendant) end
		for _, descendant in ipairs(all) do
			if descendant:IsA("GuiObject") then
				descendant.Active = false
				descendant.Interactable = false
				descendant.Selectable = false
				descendant.ZIndex = descendant.ZIndex + 10000
				if descendant:IsA("GuiButton") then descendant.AutoButtonColor = false end
			end
		end
		clone.Active = pointerBridge == true
		clone.Interactable = pointerBridge == true
		clone.Selectable = false
	end
	-- Show/hide: a preset + tween, same as hover/press. Transparency is driven across all
	-- to the clone layers (a CanvasGroup would clip shadows and strokes outside the template bounds).
	local tooltipMotionPresets = { none = true, fade = true, slide = true, pop = true, lift = true }
	local function tooltipNormalizeMotion(motion)
		if type(motion) ~= "table" then motion = {} end
		local duration = math.max(0, tonumber(motion.duration) or 0.14)
		return {
			preset = tooltipMotionPresets[motion.preset] and motion.preset or "slide",
			distance = tonumber(motion.distance) or 6,
			scaleFrom = math.max(0.01, tonumber(motion.scaleFrom) or 0.92),
			duration = duration,
			tween = typeof(motion.tween) == "TweenInfo" and motion.tween or TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		}
	end
	-- progress: 0 — hidden, 1 — shown (Back/Elastic go past the bounds — that is the overshoot)
	local function tooltipMotionFrame(motion, placement, progress, scale)
		if motion.preset == "none" then return 1, 0, 0, 1 end
		local rest = 1 - progress
		local distance = motion.distance * scale
		local dx, dy, motionScale = 0, 0, 1
		if motion.preset == "slide" then
			if placement == "top" then dy = distance * rest
			elseif placement == "bottom" then dy = -distance * rest
			elseif placement == "left" then dx = distance * rest
			elseif placement == "right" then dx = -distance * rest end
		elseif motion.preset == "lift" then
			dy = distance * rest
		elseif motion.preset == "pop" then
			motionScale = motion.scaleFrom + (1 - motion.scaleFrom) * progress
		end
		return math.clamp(progress, 0, 1), dx, dy, motionScale
	end
	local tooltipMotionOrigins = {
		top = Vector2.new(0.5, 1), bottom = Vector2.new(0.5, 0),
		left = Vector2.new(1, 0.5), right = Vector2.new(0, 0.5),
	}
	local tooltipFadeProps = {
		{ class = "GuiObject", property = "BackgroundTransparency" },
		{ class = "TextLabel", property = "TextTransparency" },
		{ class = "TextLabel", property = "TextStrokeTransparency" },
		{ class = "TextButton", property = "TextTransparency" },
		{ class = "TextButton", property = "TextStrokeTransparency" },
		{ class = "TextBox", property = "TextTransparency" },
		{ class = "TextBox", property = "TextStrokeTransparency" },
		{ class = "ImageLabel", property = "ImageTransparency" },
		{ class = "ImageButton", property = "ImageTransparency" },
		{ class = "UIStroke", property = "Transparency" },
	}
	local function tooltipCollectFade(clone)
		local targets = {}
		local all = { clone }
		for _, descendant in ipairs(clone:GetDescendants()) do table.insert(all, descendant) end
		for _, instance in ipairs(all) do
			for _, entry in ipairs(tooltipFadeProps) do
				if instance:IsA(entry.class) then
					local ok, base = pcall(function() return instance[entry.property] end)
					if ok and type(base) == "number" then table.insert(targets, { instance = instance, property = entry.property, base = base }) end
				end
			end
		end
		return targets
	end
	local function tooltipApplyFade(active, alpha)
		if not active.fade then return end
		for _, entry in ipairs(active.fade) do
			entry.instance[entry.property] = entry.base + (1 - entry.base) * (1 - alpha)
		end
	end
	local function tooltipTargetRecord(targetOrName)
		local target = targetOrName
		if type(targetOrName) == "string" then target = UI.TooltipTargets[targetOrName] end
		if typeof(target) ~= "Instance" then return nil, nil end
		return target, UI.TooltipAssignments[target]
	end
	local function tooltipCandidate(rect, size, placement, gap)
		if placement == "top" then return Vector2.new(rect.x + (rect.w - size.X) / 2, rect.y - size.Y - gap) end
		if placement == "right" then return Vector2.new(rect.x + rect.w + gap, rect.y + (rect.h - size.Y) / 2) end
		if placement == "left" then return Vector2.new(rect.x - size.X - gap, rect.y + (rect.h - size.Y) / 2) end
		return Vector2.new(rect.x + (rect.w - size.X) / 2, rect.y + rect.h + gap)
	end
	local function tooltipAvailableSpace(placement, rect, safe, gap)
		if placement == "top" then return rect.y - gap - safe.top end
		if placement == "right" then return safe.right - (rect.x + rect.w) - gap end
		if placement == "left" then return rect.x - gap - safe.left end
		return safe.bottom - (rect.y + rect.h) - gap
	end
	local function tooltipOverflow(position, size, safe)
		local top = math.max(0, safe.top - position.Y)
		local right = math.max(0, position.X + size.X - safe.right)
		local bottom = math.max(0, position.Y + size.Y - safe.bottom)
		local left = math.max(0, safe.left - position.X)
		return top + right + bottom + left
	end
	local tooltipExplicitFallbacks = {
		top = { "top", "bottom", "right", "left" },
		right = { "right", "left", "bottom", "top" },
		bottom = { "bottom", "top", "right", "left" },
		left = { "left", "right", "bottom", "top" },
	}
	local tooltipAuthoredRank = { top = 1, right = 2, bottom = 3, left = 4 }
	local function tooltipPlacementOrder(requested, rect, safe, gap)
		if requested ~= "auto" then return tooltipExplicitFallbacks[requested] end
		local order = { "top", "right", "bottom", "left" }
		table.sort(order, function(a, b)
			local aSpace = tooltipAvailableSpace(a, rect, safe, gap)
			local bSpace = tooltipAvailableSpace(b, rect, safe, gap)
			return aSpace > bSpace or (aSpace == bSpace and tooltipAuthoredRank[a] < tooltipAuthoredRank[b])
		end)
		return order
	end
	local function tooltipClampAxis(value, minimum, maximum, size)
		if maximum >= minimum then return math.clamp(value, minimum, maximum) end
		return (minimum + maximum + size) / 2 - size / 2
	end
	local function tooltipRuntimeScale()
		local scale = tonumber(UI.TooltipScale) or 1
		if scale ~= scale or scale == math.huge or scale == -math.huge then return 1 end
		return math.max(0.0001, scale)
	end
	local function tooltipPlace(active)
		if tooltipActive ~= active or not active.host.Parent or not active.clone.Parent or not active.target.Parent then return end
		local overlay = tooltipEnsureOverlay()
		if not overlay then return end
		local viewport = overlay.AbsoluteSize
		if viewport.X <= 0 or viewport.Y <= 0 then viewport = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(1920, 1080) end
		local overlayPosition = overlay.AbsolutePosition
		local targetPosition, targetSize = active.target.AbsolutePosition - overlayPosition, active.target.AbsoluteSize
		local rect = { x = targetPosition.X, y = targetPosition.Y, w = targetSize.X, h = targetSize.Y }
		if active.config.anchor == "cursor" then
			local cursor = active.config.cursor or UserInputService:GetMouseLocation()
			cursor = cursor - overlayPosition
			rect = { x = cursor.X, y = cursor.Y, w = 0, h = 0 }
		end
		local scale = tooltipRuntimeScale()
		local size = active.logicalSize * scale
		active.host.Size = UDim2.fromOffset(size.X, size.Y)
		local gap = math.max(0, tonumber(active.config.gap) or 0) * scale
		local padding = math.min(math.min(viewport.X, viewport.Y) / 2, 8 * scale)
		local safe = { left = padding, top = padding, right = viewport.X - padding, bottom = viewport.Y - padding }
		local requested = active.config.placement or "auto"
		local candidates, chosen = {}, nil
		for rank, candidatePlacement in ipairs(tooltipPlacementOrder(requested, rect, safe, gap)) do
			local position = tooltipCandidate(rect, size, candidatePlacement, gap)
			local candidate = {
				placement = candidatePlacement, rank = rank, position = position,
				overflow = tooltipOverflow(position, size, safe),
				space = tooltipAvailableSpace(candidatePlacement, rect, safe, gap),
			}
			table.insert(candidates, candidate)
			if not chosen and candidate.overflow <= 0.000001 then chosen = candidate end
		end
		if not chosen then
			table.sort(candidates, function(a, b)
				return a.overflow < b.overflow
					or (a.overflow == b.overflow and a.space > b.space)
					or (a.overflow == b.overflow and a.space == b.space and a.rank < b.rank)
			end)
			chosen = candidates[1]
		end
		local position = Vector2.new(
			tooltipClampAxis(chosen.position.X, safe.left, safe.right - size.X, size.X),
			tooltipClampAxis(chosen.position.Y, safe.top, safe.bottom - size.Y, size.Y)
		)
		-- Appear frame: the scale rides the same UIScale as the adaptivity, and the growth origin
		-- (the side facing the target) is compensated by shifting the host.
		local _, dx, dy, motionScale = tooltipMotionFrame(active.motion, chosen.placement, active.progress or 1, scale)
		active.scale.Scale = scale * motionScale
		local origin = tooltipMotionOrigins[chosen.placement] or Vector2.new(0.5, 0.5)
		dx = dx + size.X * origin.X * (1 - motionScale)
		dy = dy + size.Y * origin.Y * (1 - motionScale)
		active.host.Position = UDim2.fromOffset(position.X + dx, position.Y + dy)
		active.clone:SetAttribute("TooltipResolvedPlacement", chosen.placement)
	end
	-- A single NumberValue tween drives the progress: TweenService computes the easing, so
	-- the curve in Studio matches the constructor preview.
	local function tooltipAnimate(active, goal, onComplete)
		if active.motionTween then active.motionTween:Cancel(); active.motionTween = nil end
		if active.motionConnection then active.motionConnection:Disconnect(); active.motionConnection = nil end
		local motion = active.motion
		if motion.preset == "none" or motion.duration <= 0 then
			active.progress = goal
			tooltipApplyFade(active, math.clamp(goal, 0, 1))
			tooltipPlace(active)
			if onComplete then onComplete() end
			return
		end
		local driver = active.motionValue
		if not driver then
			driver = Instance.new("NumberValue")
			driver.Value = active.progress or 0
			active.motionValue = driver
		end
		active.motionConnection = driver:GetPropertyChangedSignal("Value"):Connect(function()
			if tooltipActive ~= active then return end
			active.progress = driver.Value
			tooltipApplyFade(active, math.clamp(driver.Value, 0, 1))
			tooltipPlace(active)
		end)
		local tween = TweenService:Create(driver, motion.tween, { Value = goal })
		active.motionTween = tween
		if onComplete then
			tween.Completed:Connect(function(state) if state == Enum.PlaybackState.Completed then onComplete() end end)
		end
		tween:Play()
	end
	local function tooltipDestroy()
		if tooltipPositionConnection then tooltipPositionConnection:Disconnect(); tooltipPositionConnection = nil end
		local active = tooltipActive
		tooltipActive = nil
		if active then
			for _, connection in ipairs(active.connections or {}) do connection:Disconnect() end
			if active.motionTween then active.motionTween:Cancel(); active.motionTween = nil end
			if active.motionConnection then active.motionConnection:Disconnect(); active.motionConnection = nil end
			if active.motionValue then active.motionValue:Destroy(); active.motionValue = nil end
			if active.host then active.host:Destroy() elseif active.clone then active.clone:Destroy() end
			UI.EmitEvent("TooltipHidden", active.target, active.config.name)
		end
	end
	-- Hiding plays the same tween backwards; hovering again before it ends
	-- animations pick up the current progress (see tooltipRequestShow).
	local function tooltipHide(active)
		if not active or tooltipActive ~= active or active.hiding then return end
		if active.motion.preset == "none" or active.motion.duration <= 0 then tooltipDestroy(); return end
		active.hiding = true
		tooltipAnimate(active, 0, function()
			if tooltipActive == active and active.hiding then tooltipDestroy() end
		end)
	end
	local function tooltipShowNow(target, config, suppliedValues)
		local template = UI.TooltipTemplates[config.prefabId]
		local overlay = tooltipEnsureOverlay()
		if not template or not template.template or not template.template.Parent or not overlay then return false end
		tooltipMergeValues(config, template, suppliedValues)
		tooltipDestroy()
		local clone = template.template:Clone()
		clone.Name = "Tooltip_" .. tostring(config.name or target.Name)
		clone.AnchorPoint = Vector2.zero
		clone.Position = UDim2.fromOffset(0, 0) -- position stays physical on the unscaled host
		clone.Visible = false
		tooltipApplyBindings(clone, template, config.values)
		tooltipSanitize(clone, config.pointerBridge)
		local authoredSize = clone.Size
		local logicalSize = typeof(template.logicalSize) == "Vector2" and template.logicalSize or Vector2.new(math.max(1, authoredSize.X.Offset), math.max(1, authoredSize.Y.Offset))
		clone.Size = UDim2.fromOffset(logicalSize.X, logicalSize.Y) -- host bounds do not feed back into clone scaling
		local host = Instance.new("Frame")
		host.Name = clone.Name .. "_Host"
		host.BackgroundTransparency = 1
		host.BorderSizePixel = 0
		host.AnchorPoint = Vector2.zero
		host.Active = false
		host.ZIndex = 10000
		host.Parent = overlay
		local cloneScale = Instance.new("UIScale")
		cloneScale.Name = "TooltipScale"
		cloneScale.Parent = clone
		clone.Parent = host
		local motion = tooltipNormalizeMotion(config.motion)
		local active = { target = target, config = config, host = host, clone = clone, scale = cloneScale, logicalSize = logicalSize, connections = {}, bridge = false, motion = motion, hiding = false }
		active.fade = tooltipCollectFade(clone)
		active.progress = (motion.preset == "none" or motion.duration <= 0) and 1 or 0
		tooltipApplyFade(active, active.progress)
		tooltipActive = active
		if config.pointerBridge then
			table.insert(active.connections, clone.MouseEnter:Connect(function() active.bridge = true; tooltipSerial = tooltipSerial + 1 end))
			table.insert(active.connections, clone.MouseLeave:Connect(function()
				active.bridge = false
				if not config.hovered and not config.focused then
					tooltipSerial = tooltipSerial + 1; local token = tooltipSerial
					task.delay(math.max(0, tonumber(config.hideDelay) or 0), function() if token == tooltipSerial and tooltipActive == active then tooltipHide(active) end end)
				end
			end))
		end
		clone.Visible = true
		tooltipPlace(active)
		tooltipAnimate(active, 1)
		tooltipPositionConnection = RunService.RenderStepped:Connect(function()
			if not target.Parent then tooltipSerial = tooltipSerial + 1; tooltipDestroy() else tooltipPlace(active) end
		end)
		UI.EmitEvent("TooltipShown", target, config.name, clone)
		return true
	end
	local function tooltipRequestShow(target, config)
		tooltipSerial = tooltipSerial + 1
		local token = tooltipSerial
		if tooltipActive and tooltipActive.target == target then
			-- Came back before the hide animation finished: we play it back from the current frame.
			if tooltipActive.hiding then tooltipActive.hiding = false; tooltipAnimate(tooltipActive, 1) end
			return
		end
		task.delay(math.max(0, tonumber(config.delay) or 0), function()
			if token == tooltipSerial and target.Parent and (config.hovered or config.focused) then tooltipShowNow(target, config) end
		end)
	end
	local function tooltipRequestHide(target, config)
		tooltipSerial = tooltipSerial + 1
		local token = tooltipSerial
		if config.hovered or config.focused or (tooltipActive and tooltipActive.bridge) then return end
		task.delay(math.max(0, tonumber(config.hideDelay) or 0), function()
			if token == tooltipSerial and tooltipActive and tooltipActive.target == target and not config.hovered and not config.focused and not tooltipActive.bridge then tooltipHide(tooltipActive) end
		end)
	end
	function UI.RegisterTooltipTemplate(prefabId, template)
		if type(prefabId) ~= "string" or type(template) ~= "table" or typeof(template.template) ~= "Instance" then return false end
		template.template.Visible = false
		template.template.Archivable = true
		UI.TooltipTemplates[prefabId] = template
		return true
	end
	function UI.BindTooltip(target, config)
		if typeof(target) ~= "Instance" or not target:IsA("GuiObject") or type(config) ~= "table" then return false end
		config.name = config.name or target.Name; config.id = config.id or config.name
		config.values = config.values or {}
		config.placement = table.find({ "auto", "top", "right", "bottom", "left" }, config.placement) and config.placement or "auto"
		config.anchor = config.anchor == "cursor" and "cursor" or "target"
		config.delay = math.max(0, tonumber(config.delay) or 0.15)
		config.hideDelay = math.max(0, tonumber(config.hideDelay) or 0.12)
		config.gap = math.max(0, tonumber(config.gap) or 10)
