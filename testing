	-- A hard mask for image progress: the image never changes size, a UIGradient hides the right part
	function UI.SetProgressMask(gradient, value)
		local x = math.clamp(value, 0, 1)
		if x <= 0 then gradient.Transparency = NumberSequence.new(1) return end
		if x >= 1 then gradient.Transparency = NumberSequence.new(0) return end
		local edge = math.max(0.000001, x - 0.001)
		if edge >= x then edge = x * 0.5 end
		gradient.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0),
			NumberSequenceKeypoint.new(edge, 0),
			NumberSequenceKeypoint.new(x, 1),
			NumberSequenceKeypoint.new(1, 1),
		})
	end

	-- The mask covers only the [fromValue, toValue] range: predict-loss does not depend on the transparency of the main image/gradient.
	function UI.SetProgressRangeMask(gradient, fromValue, toValue)
		local a = math.clamp(math.min(fromValue, toValue), 0, 1)
		local b = math.clamp(math.max(fromValue, toValue), 0, 1)
		local edge = 0.001
		if b - a <= 0.000001 then gradient.Transparency = NumberSequence.new(1) return end
		if a <= edge and b >= 1 - edge then gradient.Transparency = NumberSequence.new(0) return end
		if a <= edge then
			gradient.Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0),
				NumberSequenceKeypoint.new(b, 0),
				NumberSequenceKeypoint.new(math.min(1, b + edge), 1),
				NumberSequenceKeypoint.new(1, 1),
			})
			return
		end
		if b >= 1 - edge then
			gradient.Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 1),
				NumberSequenceKeypoint.new(math.max(0, a - edge), 1),
				NumberSequenceKeypoint.new(a, 0),
				NumberSequenceKeypoint.new(1, 0),
			})
			return
		end
		gradient.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(math.max(0, a - edge), 1),
			NumberSequenceKeypoint.new(a, 0),
			NumberSequenceKeypoint.new(b, 0),
			NumberSequenceKeypoint.new(math.min(1, b + edge), 1),
			NumberSequenceKeypoint.new(1, 1),
		})
	end

	-- A rectangular progress cut: the clipper trims by fraction, the paint is stretched back to the full
	-- track width and carries ITS OWN corner. UICorner never masks children (measured: neither through
	-- ClipsDescendants nor CanvasGroup), so the shape must live on the paint itself, while
	-- the right cut belongs to the clipper. The 1/x stretch is non-linear, hence the clipper+paint pair.
	function UI.SetProgressClip(clip, paint, value)
		local x = math.clamp(value, 0, 1)
		clip.Size = UDim2.fromScale(x, 1)
		paint.Size = UDim2.fromScale(x > 0.0001 and 1 / x or 1, 1)
	end

	-- A range cut [from, to] — the predict-loss tail: the clipper sits at a with width b-a,
	-- the paint shifts back so its geometry matches the full track width.
	function UI.SetProgressClipRange(clip, paint, fromValue, toValue)
		local a = math.clamp(math.min(fromValue, toValue), 0, 1)
		local b = math.clamp(math.max(fromValue, toValue), 0, 1)
		local w = b - a
		if w <= 0.0001 then clip.Size = UDim2.fromScale(0, 1) return end
		clip.Position = UDim2.fromScale(a, 0)
		clip.Size = UDim2.fromScale(w, 1)
		paint.Position = UDim2.fromScale(-a / w, 0)
		paint.Size = UDim2.fromScale(1 / w, 1)
	end

	-- Manual bars (no binding): UI.SetValue("XpBar", 75)
	function UI.SetValue(barName, value)
		local bar = UI.Bars[barName]
		if not bar then return end
		local fraction = math.clamp(value / bar.max, 0, 1)
		if bar.mode == "mask" then
			UI.SetProgressMask(bar.fill, fraction)
		elseif bar.mode == "clip" then
			local from = bar.fill.Size.X.Scale
			local v = Instance.new("NumberValue")
			v.Value = from
			v.Changed:Connect(function(x) UI.SetProgressClip(bar.fill, bar.paint, x) end)
			local tw = TweenService:Create(v, UI.BarInfo, { Value = fraction })
			tw.Completed:Connect(function() v:Destroy() end)
			tw:Play()
		else
			TweenService:Create(bar.fill, UI.BarInfo, { Size = UDim2.fromScale(fraction, 1) }):Play()
		end
		if bar.label then
			local text = string.format("%d / %d", math.floor(value + 0.5), bar.max)
			bar.label.Text = text
			local shadow = bar.label.Parent and bar.label.Parent:FindFirstChild(bar.label.Name .. "Shadow")
			if shadow then shadow.Text = text end
		end
	end

	-- === Project theme ===
	-- Binds an instance property to a theme token; UI.SetTheme recolors everything at once:
	-- UI.SetTheme({ Primary = Color3.fromRGB(255, 80, 80), MainFont = Font.new("rbxasset://fonts/families/BuilderSans.json", Enum.FontWeight.Bold, Enum.FontStyle.Normal) })
	local themeBinds = {}
	local themeValueBinds = {}
	function UI.BindTheme(inst, prop, token)
		table.insert(themeBinds, { inst = inst, prop = prop, token = token })
		local v = UI.Theme[token]
		if v ~= nil then inst[prop] = v end
	end
	function UI.BindThemeValue(token, fn)
		table.insert(themeValueBinds, { token = token, fn = fn })
		local v = UI.Theme[token]
		if v ~= nil then fn(v) end
	end
	function UI.SetTheme(overrides)
		for k, v in pairs(overrides) do UI.Theme[k] = v end
		for _, b in ipairs(themeBinds) do
			local v = UI.Theme[b.token]
			if v ~= nil then b.inst[b.prop] = v end
		end
		for _, b in ipairs(themeValueBinds) do
			local v = UI.Theme[b.token]
			if v ~= nil then b.fn(v) end
		end
	end

	-- The shadow is exported as a sibling placed before its owner. This link mirrors the geometry
	-- of the owner during TweenService/keyframe animations, without storing the shadow in every state snapshot.
	function UI.BindShadow(gui, shadow, cfg)
		local function sync()
			local size = gui.Size
			if cfg.soft then
				local ax = gui.AnchorPoint.X
				local ay = gui.AnchorPoint.Y
				shadow.AnchorPoint = Vector2.new(0.5, 0.5)
				shadow.Position = UDim2.new(
					gui.Position.X.Scale + size.X.Scale * (0.5 - ax),
					gui.Position.X.Offset + size.X.Offset * (0.5 - ax) + cfg.offsetX,
					gui.Position.Y.Scale + size.Y.Scale * (0.5 - ay),
					gui.Position.Y.Offset + size.Y.Offset * (0.5 - ay) + cfg.offsetY
				)
				shadow.Size = UDim2.new(size.X.Scale, size.X.Offset + cfg.blur * 2, size.Y.Scale, size.Y.Offset + cfg.blur * 2)
			else
				shadow.AnchorPoint = gui.AnchorPoint
				shadow.Position = UDim2.new(
					gui.Position.X.Scale, gui.Position.X.Offset + cfg.offsetX,
					gui.Position.Y.Scale, gui.Position.Y.Offset + cfg.offsetY
				)
				shadow.Size = size
			end
			-- a rotated 9-slice shadow shows seams between segments (engine limitation:
			-- neighbouring pieces overlap by a fraction of a pixel, and on a semi-transparent shadow that
			-- shows up as dark bands). The tilt preset's micro-rotation on a blurred blob
			-- is invisible, so we never rotate such a shadow — there is no artifact.
			if not cfg.ignoreRotation then shadow.Rotation = gui.Rotation end
			shadow.ZIndex = gui.ZIndex -- the same layer; the creation order keeps the owner above its shadow
		end
		sync()
		gui:GetPropertyChangedSignal("Position"):Connect(sync)
		gui:GetPropertyChangedSignal("Size"):Connect(sync)
		gui:GetPropertyChangedSignal("AnchorPoint"):Connect(sync)
		gui:GetPropertyChangedSignal("Rotation"):Connect(sync)
		gui:GetPropertyChangedSignal("ZIndex"):Connect(sync)
	end

	function UI.BindFX(gui, cfg)
		local fxScale = Instance.new("UIScale")
		fxScale.Name = "FXScale"
		fxScale.Parent = gui
		local baseRotation = gui.Rotation
		-- Color shift tints the ImageLabel/ImageButton itself or the child FillImage, not the transparent background
		local colorTarget = gui
		local colorProp = "BackgroundColor3"
		if gui:IsA("ImageLabel") or gui:IsA("ImageButton") then
			colorProp = "ImageColor3"
		else
			local fillImage = gui:FindFirstChild("FillImage")
			if fillImage and (fillImage:IsA("ImageLabel") or fillImage:IsA("ImageButton")) then
				colorTarget = fillImage
				colorProp = "ImageColor3"
			end
		end
		local baseColor = colorTarget[colorProp]
		-- A "hover only" shadow: its own UIScale (grows slightly more than the button)
		local shadowScale = nil
		local shadowProp = "BackgroundTransparency"
		if cfg.shadow then
			if cfg.shadow:IsA("UIShadow") then
				-- A native shadow is a modifier INSIDE the element: it scales together with it
				-- through its own UIScale, so it needs none of its own (and must not have one: UIShadow
				-- not a GuiObject). Its transparency is simply called Transparency.
				shadowProp = "Transparency"
			else
				shadowScale = Instance.new("UIScale")
				shadowScale.Parent = cfg.shadow
				if cfg.shadow:IsA("ImageLabel") then shadowProp = "ImageTransparency" end
			end
		end
		local function play(obj, props, info)
			TweenService:Create(obj, info or cfg.info, props):Play()
		end
		gui.MouseEnter:Connect(function()
			play(fxScale, { Scale = cfg.hoverScale })
			if cfg.glow then play(cfg.glow, { Transparency = 0.25 }) end
			if cfg.tilt then play(gui, { Rotation = baseRotation + cfg.tilt }) end
			if cfg.hoverColor then play(colorTarget, { [colorProp] = cfg.hoverColor }) end
			if cfg.shadow then
				if cfg.shadowTransparency ~= nil then play(cfg.shadow, { [shadowProp] = cfg.shadowTransparency }) end
				if shadowScale then play(shadowScale, { Scale = cfg.shadowScale }) end
			end
		end)
		gui.MouseLeave:Connect(function()
			play(fxScale, { Scale = 1 })
			if cfg.glow then play(cfg.glow, { Transparency = 1 }) end
			if cfg.tilt then play(gui, { Rotation = baseRotation }) end
			if cfg.hoverColor then play(colorTarget, { [colorProp] = baseColor }) end
			if cfg.shadow then
				if cfg.shadowTransparency ~= nil then play(cfg.shadow, { [shadowProp] = 1 }) end
				if shadowScale then play(shadowScale, { Scale = 1 }) end
			end
		end)
		-- press events: from the button itself, or from pressSource (for a Frame knob — its track)
		local pressGui = (cfg.pressScale and gui:IsA("GuiButton")) and gui or (cfg.pressSource and cfg.pressSource:IsA("GuiButton") and cfg.pressSource)
		if cfg.pressScale and pressGui then
			local pressInfo = TweenInfo.new(math.max(0.06, cfg.info.Time * 0.6), cfg.info.EasingStyle, cfg.info.EasingDirection)
			pressGui.MouseButton1Down:Connect(function()
				play(fxScale, { Scale = cfg.pressScale }, pressInfo)
				if shadowScale then play(shadowScale, { Scale = cfg.shadowPressScale or cfg.pressScale }, pressInfo) end
			end)
			pressGui.MouseButton1Up:Connect(function()
				play(fxScale, { Scale = cfg.hoverScale }, pressInfo)
				if shadowScale then play(shadowScale, { Scale = cfg.shadowScale }, pressInfo) end
			end)
		end
	end

	-- === Toggles ===
	function UI.BindToggle(name, t)
		UI.Toggles[name] = t
		t.callback = nil
		-- The label stroke (Contextual UIStroke) does not inherit TextTransparency — we fade it
		-- separately, blending with its own base transparency (otherwise it hangs around hidden text).
		local onStroke = t.onLabel and t.onLabel:FindFirstChildOfClass("UIStroke")
		local offStroke = t.offLabel and t.offLabel:FindFirstChildOfClass("UIStroke")
		-- The base comes from the config, NOT from stroke.Transparency: on a label hidden at start
		-- the stroke already sits at 1, and capturing from the DOM would leave it invisible after switching.
		local strokeBase = t.labelStrokeTr or 0
		local shadowBase = t.labelShadowTr or 0.35
		local function fadeLabel(label, stroke, tr)
			if label then TweenService:Create(label, t.info, { TextTransparency = tr }):Play() end
			if stroke then TweenService:Create(stroke, t.info, { Transparency = strokeBase + (1 - strokeBase) * tr }):Play() end
			-- the inline text shadow (the "<Label>Shadow" sibling) fades together with the label
			local shadow = label and label.Parent and label.Parent:FindFirstChild(label.Name .. "Shadow")
			if shadow then
				local shTr = shadowBase + (1 - shadowBase) * tr
				TweenService:Create(shadow, t.info, { TextTransparency = shTr }):Play()
				-- the shadow stroke is Contextual too — faded separately so the outline never hangs around a hidden shadow
				local shStroke = shadow:FindFirstChildOfClass("UIStroke")
				if shStroke then TweenService:Create(shStroke, t.info, { Transparency = shTr }):Play() end
			end
		end
		function t.apply(value)
			t.value = value
			local trackGoal = { BackgroundColor3 = value and t.colorOn or t.colorOff }
			if t.trOn or t.trOff then trackGoal.BackgroundTransparency = value and (t.trOn or 0) or (t.trOff or 0) end
			TweenService:Create(t.track, t.info, trackGoal):Play()
			TweenService:Create(t.knob, t.info, { Position = value and t.posOn or t.posOff }):Play()
			fadeLabel(t.onLabel, onStroke, value and (t.labelTr or 0) or 1)
			fadeLabel(t.offLabel, offStroke, value and 1 or (t.labelTr or 0))
			if t.callback then
				t.callback(value)
			end
		end
		if t.colorOnToken then
			UI.BindThemeValue(t.colorOnToken, function(value)
				t.colorOn = value
				if t.value then t.track.BackgroundColor3 = value end
			end)
		end
		if t.colorOffToken then
			UI.BindThemeValue(t.colorOffToken, function(value)
				t.colorOff = value
				if not t.value then t.track.BackgroundColor3 = value end
			end)
		end
		t.track.MouseButton1Click:Connect(function()
			t.apply(not t.value)
		end)
	end
	function UI.SetToggle(name, value)
		local t = UI.Toggles[name]
		if t then t.apply(value) end
	end
	function UI.OnToggle(name, fn)
		local t = UI.Toggles[name]
		if t then t.callback = fn end
	end

	-- === Spinning gradients (GPO style) ===
	local spinning = {}
	local spinConn = nil
	function UI.Spin(gradient, speed)
		table.insert(spinning, { gradient = gradient, speed = speed })
		if not spinConn then
			spinConn = RunService.Heartbeat:Connect(function(dt)
				for _, item in ipairs(spinning) do
					item.gradient.Rotation = (item.gradient.Rotation + item.speed * dt) % 360
				end
			end)
		end
	end

	-- Adaptive 9-slice: SliceScale follows the short side of AbsoluteSize
	-- (base — at the reference refShort), clamped to [minv, maxv]. Scale strategy only.
	function UI.BindSliceScale(obj, base, refShort, minv, maxv)
		-- The element's own UIScale (hover/press grow) already stretches the 9-slice borders.
		-- Counting it once more in SliceScale would scale the borders twice and push them past
		-- half the element, they overlap in the center and show as bands on a semi-transparent shadow.
		local function ownScale()
			local s = 1
			for _, child in ipairs(obj:GetChildren()) do
				if child:IsA("UIScale") then s = s * child.Scale end
			end
			return s > 0 and s or 1
		end
		local function upd()
			local short = math.min(obj.AbsoluteSize.X, obj.AbsoluteSize.Y) / ownScale()
			local value = math.clamp(base * (short / math.max(1, refShort)), minv, maxv)
			-- Safety net: a border must never exceed half of the short side, otherwise
			-- the opposite borders overlap each other (double alpha = bands).
			local border = math.max(obj.SliceCenter.Min.X, obj.SliceCenter.Min.Y)
			if border > 0 then value = math.min(value, short / (2 * border)) end
			obj.SliceScale = math.max(value, 0)
		end
		obj:GetPropertyChangedSignal("AbsoluteSize"):Connect(upd)
		upd()
	end

	return UI
end)()

